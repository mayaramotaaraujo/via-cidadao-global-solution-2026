# Copie este arquivo para .env e preencha. O .env NUNCA deve ir para o Git.

# --- Back-end ---------------------------------------------------------------
LLM_PROVIDER=openai                 # openai (produção) | fake (testes/offline, sem IA real)
OPENAI_API_KEY=sk-...sua-chave-aqui
OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SEGUNDOS=30
ALLOWED_ORIGINS=http://localhost:8501   # lista separada por vírgula; nunca "*" em produção
GESTOR_TOKEN=troque-por-um-codigo-forte   # 16+ caracteres; em produção a API não sobe com valor fraco
LIMITE_ANALISES_POR_MINUTO=8
PROXIES_CONFIAVEIS=0                # 0 local; 1 atrás do proxy do Render
REDES_PROXY=                        # opcional: CIDRs do proxy, ex.: 10.0.0.0/8
DB_PATH=data/zelo.db
SEED_DEMO=true                      # popula o painel com relatos SIMULADOS (identificados na interface)
CLIMA_HABILITADO=true
AMBIENTE=desenvolvimento            # producao remove "*" do CORS mesmo se configurado

# --- Front-end ----------------------------------------------------------------
API_URL=http://localhost:8000
