# Copie para .env (cp .env.example .env). O .env NÃO vai para o Git.

# ---- E-mail -------------------------------------------------------------
# "arquivo" (padrão): as mensagens são salvas como .eml em saida/<execução>/outbox
# "smtp": envia de verdade usando as variáveis abaixo
EMAIL_MODO=arquivo
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORTA=2525
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=1
SMTP_REMETENTE=robo.zelo@example.com
EMAIL_COORDENACAO=coordenacao.zeladoria@example.com

# ---- Open-Meteo (pública, não precisa de chave) --------------------------
CLIMA_HABILITADO=1

# ---- API do app Zelo (opcional) ------------------------------------------
# Sem estas duas, o robô lê o arquivo entrada/app_zelo_*.json
ZELO_API_URL=
ZELO_GESTOR_TOKEN=
