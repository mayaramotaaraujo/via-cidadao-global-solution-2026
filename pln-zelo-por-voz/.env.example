# Copie este arquivo para .env e preencha a chave. O .env NÃO vai para o GitHub.
OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# STT (faster-whisper local): tiny | base | small | medium
ZELO_STT_MODEL=small
ZELO_STT_DEVICE=cpu
ZELO_STT_COMPUTE=int8
ZELO_STT_BEAM=1

# LLM: openai | ollama
ZELO_LLM_PROVIDER=openai
ZELO_LLM_MODEL=gpt-4o-mini
ZELO_LLM_TEMPERATURE=0.2
ZELO_LLM_MAX_TOKENS=220
# OLLAMA_URL=http://localhost:11434

# Memória e RAG
ZELO_HISTORY_TURNS=6
ZELO_RAG_TOP_K=4

# TTS: edge (online, padrão, com reserva offline no Mac) | mac (só offline)
ZELO_TTS_PROVIDER=edge
ZELO_TTS_VOICE=pt-BR-FranciscaNeural
ZELO_TTS_RATE=-5%
ZELO_TTS_MAC_VOICE=Luciana
